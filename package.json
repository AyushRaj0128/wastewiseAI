{
  "name": "wastewise-ai",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered smart waste management and sustainability decision platform.",
  "workspaces": ["client", "server"],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "concurrently \"npm:dev --workspace server\" \"npm:dev --workspace client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
